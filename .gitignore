# Local tooling state (Mimosa security scanner)
.mimosa/

# Benchmark/physical-evidence scratch: samples, logs, run outputs.
# Only curated evidence reports under docs/ are committed.
evidence/

# Build outputs (regenerated by the pocket.ts compile / cargo build).
dist/
.pocket/
native/target/

# Local dependency install (owner workspace state; see docs evidence for
# the exact toolchain identity used per ticket), plus the vendored PocketJS
# framework's own install (bun install --frozen-lockfile, see
# scripts/build-guest.ps1).
node_modules/
__pycache__/

# Transient PocketJS app-check scratch directory (removed by the compiler).
.pocketjs-app-check-*/

# A/B control binary target dir (investigation only, never committed)
native/target-nog/

# Release artifacts (regenerated by scripts/build-windows-release.ps1).
dist-release/
