{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.picoview.app",
  "name": "picoview",
  "title": "PicoView",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.viewport.live"
      ]
    }
  },
  "app": {
    "entry": "guest/main.octane.tsx",
    "output": "picoview",
    "framework": "octane",
    "viewport": {
      "dynamic": {
        "default": [960, 640],
        "min": [384, 240],
        "max": [4096, 4096]
      }
    }
  }
}
