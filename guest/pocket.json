{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.picoview.arch-a3-guest",
  "name": "picoview-arch-a3-guest",
  "title": "PicoView A3 Guest",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons",
        "display.viewport.live"
      ]
    }
  },
  "app": {
    "entry": "guest/main.octane.tsx",
    "output": "picoview-a3-main",
    "framework": "octane",
    "viewport": {
      "dynamic": {
        "default": [720, 480],
        "min": [320, 240],
        "max": [4096, 4096]
      }
    }
  }
}
